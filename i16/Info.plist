	<!-- SpringBoard 靠这几个字段判断"这个包能不能在本平台跑"。
	     缺了 CFBundleSupportedPlatforms 会直接拒绝启动 —— 表现为 uiopen 返回 0、
	     进程从不出现、连崩溃日志都不留。MacPad 上踩过同一个坑。 -->
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>DTPlatformName</key>
	<string>iphoneos</string>
	<key>DTPlatformVersion</key>
	<string>12.4</string>
	<key>DTSDKName</key>
