<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>AppStoreVersionSpoofer</string>
    <key>preferences</key>
    <dict>
        <key>suiteName</key>
        <string>com.custom.appstoreversionspoofer</string>
        <key>defaultValues</key>
        <dict>
            <key>enableSpoof</key>
            <false/>
            <key>fakeVer</key>
            <string>15.0</string>
        </dict>
    </dict>
    <key>specifiers</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>仅供个人学习研究。伪造系统版本绕过 App Store 校验违反 Apple 用户协议，可能导致 Apple ID 封禁或设备异常，风险自担。</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>启用版本伪装</string>
            <key>key</key>
            <string>enableSpoof</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>label</key>
            <string>伪装 iOS 版本号</string>
            <key>key</key>
            <string>fakeVer</string>
            <key>placeholder</key>
            <string>例如:15.0</string>
            <key>keyboard</key>
            <string>UIKeyboardTypeNumbersAndPunctuation</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>重启 SpringBoard 生效</string>
            <key>action</key>
            <string>respring:</string>
        </dict>
    </array>
</dict>
</plist>
